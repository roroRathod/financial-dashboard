# Server Configuration
PORT=8000
CACHE_TTL_SECONDS=300
YFINANCE_TIMEOUT=30

# BYOK AI Configuration (OpenAI-Compatible / Ollama / vLLM / Cloud Providers)
OPENAI_API_BASE=http://localhost:3001/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=auto

